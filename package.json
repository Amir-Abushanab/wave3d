{
  "name": "wave3d-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Wave Studio and the @wave3d packages that power it",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "hooks:install": "git config core.hooksPath .githooks",
    "dev": "pnpm --filter wave-studio dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"@wave3d/*\" build",
    "pack:all": "pnpm -r --filter \"@wave3d/*\" exec pnpm pack",
    "version": "changeset version && node scripts/sync-skill-version.mjs",
    "release": "pnpm build:packages && node scripts/publish-if-needed.mjs",
    "preview": "pnpm --filter wave-studio preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . '!gallery/waves/**'",
    "format:check": "oxfmt . --check '!gallery/waves/**'",
    "depcruise": "dependency-cruiser apps packages",
    "knip": "knip",
    "skill:validate": "intent validate packages/core/skills",
    "gallery:validate": "node scripts/validate-gallery.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm depcruise && pnpm knip && pnpm skill:validate && pnpm gallery:validate",
    "ncu": "pnpm dlx npm-check-updates"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@tanstack/intent": "^0.3.6",
    "dependency-cruiser": "^18.1.0",
    "knip": "^6.29.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsdown": "^0.22.13",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.16.0"
}
