{
  "name": "wave3d-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Wave Studio and the @wave3d packages that power it",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "hooks:install": "git config core.hooksPath .githooks",
    "dev": "pnpm --filter wave-studio dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"@wave3d/*\" build",
    "pack:all": "pnpm -r --filter \"@wave3d/*\" exec pnpm pack",
    "version": "changeset version && node scripts/sync-skill-version.mjs",
    "release": "pnpm build:packages && node scripts/publish-if-needed.mjs",
    "preview": "pnpm --filter wave-studio preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . '!gallery/waves/**'",
    "format:check": "oxfmt . --check '!gallery/waves/**'",
    "depcruise": "dependency-cruiser apps packages",
    "knip": "knip",
    "skill:validate": "pnpm --filter @wave3d/core skill:validate",
    "gallery:validate": "node scripts/validate-gallery.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm depcruise && pnpm knip && pnpm skill:validate && pnpm gallery:validate && pnpm check:chunks",
    "ncu": "pnpm dlx npm-check-updates",
    "skill:stale": "pnpm --filter @wave3d/core skill:stale",
    "check:chunks": "node scripts/check-webgpu-chunk.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.42.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.15.0"
}
